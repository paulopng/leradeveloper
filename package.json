{
  "name": "leradeveloper",
  "version": "0.2.0",
  "description": "Browse, install, and track AI agent personas across Claude Code, Codex, Cursor, Gemini CLI, Copilot, Qwen, opencode and more — in your browser.",
  "type": "module",
  "author": "Paulo Felipe (paulopng)",
  "contributors": [
    "Michael Sitarzewski (Agency Agents, the original app this is built on)"
  ],
  "repository": "github:paulopng/leradeveloper",
  "license": "MIT",
  "bin": {
    "leradeveloper": "bin/leradeveloper.js",
    "lera-decisor": "bin/lera-decisor.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "start": "node bin/leradeveloper.js",
    "dev": "node scripts/dev.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "@lucide/svelte": "^1.16.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
